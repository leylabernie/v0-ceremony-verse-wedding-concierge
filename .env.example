MAILCHIMP_API_KEY=your-mailchimp-api-key
MAILCHIMP_SERVER=us4
MAILCHIMP_AUDIENCE_ID=your-audience-id

# Consultation request and questionnaire delivery
# Keep the API key in Vercel environment variables; never commit a real key.
RESEND_API_KEY=your-resend-api-key
CEREMONYVERSE_LEAD_FROM_EMAIL="CeremonyVerse <hello@ceremonyverse.com>"

# Optional CRM/automation webhook. Email delivery remains the owner-facing
# delivery path for completed pre-call questionnaires.
CEREMONYVERSE_LEAD_WEBHOOK_URL=
CEREMONYVERSE_LEAD_WEBHOOK_SECRET=

# IndexNow — generates a random secret with: openssl rand -hex 16
# This protects the /api/indexnow endpoint from abuse.
INDEXNOW_SECRET=generate-a-random-secret-here

# ---------------------------------------------------------------------------
# Mini's Assistant — AI concierge chat widget + lead capture
# ---------------------------------------------------------------------------
# Public (NEXT_PUBLIC_*) values are exposed to the browser. Set real values in
# .env.local for local dev and in the Vercel dashboard for production.

NEXT_PUBLIC_BOT_ID=            # Abacus AI ChatLLM Bot ID
NEXT_PUBLIC_SITE_KEY=          # Abacus AI ChatLLM Site Key
NEXT_PUBLIC_WIDGET_SCRIPT_URL= # Abacus AI ChatLLM embed script URL (fallback: https://apps.abacus.ai/chatllm/embed.js)
NEXT_PUBLIC_CALENDLY_URL=      # Calendly scheduling link (already on website)

LEAD_SHEET_WEBHOOK_URL=        # Zapier/Make webhook URL -> Google Sheet row (must be https)
FOLLOW_UP_WEBHOOK_URL=         # Webhook to trigger Day 1/3/7/14 follow-up email sequence
ESCALATION_WEBHOOK_URL=        # Webhook for hot-lead WhatsApp alerts to Mini (Zapier -> WhatsApp)

MINI_WHATSAPP_NUMBER=12153419990  # Mini's WhatsApp for escalations
CALENDAR_URL=                  # Consultation calendar link (placeholder; Calendly handles booking client-side)

# Confirmation emails from /api/lead-capture (optional — leave blank to skip).
# Requires the `nodemailer` package to be installed.
SMTP_HOST=                     # Email SMTP host for confirmation emails
SMTP_PORT=                     # Email SMTP port (465 = SSL, 587 = STARTTLS)
SMTP_USER=                     # Email SMTP username
SMTP_PASS=                     # Email SMTP password
SMTP_FROM=                     # From address (e.g. hello@ceremonyverse.com)

# Knowledge-base sync GitHub Action (stored as a GitHub Actions secret, not here).
# Should point to the Abacus AI knowledge base ingestion endpoint.
KNOWLEDGE_BASE_WEBHOOK_URL=
