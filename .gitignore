# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# This project uses pnpm — pnpm-lock.yaml is the ONLY committed lockfile.
# Vercel detects pnpm-lock.yaml and installs with `pnpm --frozen-lockfile`,
# so a stale or competing lockfile fails the deploy at the install step.
# Ignored here so an accidental `npm install` cannot commit one back.
package-lock.json
yarn.lock

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts